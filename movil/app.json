{
  "expo": {
    "name": "Tienda La 635",
    "slug": "movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Se usa para entender lo que dice y armar su pedido.",
        "NSMicrophoneUsageDescription": "Se usa para escuchar lo que pide por voz."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#012D45"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.movil"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Se usa para elegir la foto de su perfil."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Se usa para escuchar lo que pide por voz.",
          "speechRecognitionPermission": "Se usa para entender lo que dice y armar su pedido."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "color": "#012D45",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Se usa para llenar su dirección con su ubicación actual."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Se usa para escuchar lo que pide por voz."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "b074da1e-1146-4d9f-8002-3f70706b211b"
      }
    },
    "owner": "andrew12wwu"
  }
}
