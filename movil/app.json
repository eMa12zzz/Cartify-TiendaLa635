{
  "expo": {
    "name": "Tienda la 635",
    "slug": "movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tiendala635",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b074da1e-1146-4d9f-8002-3f70706b211b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tiendala635.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Para entender lo que dices y armar tu pedido.",
        "NSMicrophoneUsageDescription": "Para escuchar lo que pides por voz."
      }
    },
    "android": {
      "package": "com.tiendala635.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#012D45"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "cartify-tienda-la635.vercel.app",
              "pathPrefix": "/producto/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121417"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir la foto de tu perfil."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Para escuchar lo que pides por voz.",
          "speechRecognitionPermission": "Para entender lo que dices y armar tu pedido."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/poppins/800ExtraBold/Poppins_800ExtraBold.ttf"
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/notificacion.png",
          "color": "#003049",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para llenar tu dirección con tu ubicación actual y, si repartes para la tienda, mostrarle al cliente por dónde va su pedido."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Para escuchar lo que pides por voz."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "b074da1e-1146-4d9f-8002-3f70706b211b"
      }
    },
    "owner": "andrew12wwu"
  }
}
