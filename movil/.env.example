# Variables del móvil. Copiá este archivo como .env y llená los valores.
# Expo solo expone al bundle las que empiezan con EXPO_PUBLIC_.

# WhatsApp de la tienda para el botón de contacto en Mi cuenta > Ayuda.
# Formato internacional, solo dígitos: 503 (El Salvador) + los 8 del número.
# Mismo valor que VITE_WHATSAPP en frontend/.env.example.
# Si se deja vacío, el botón simplemente no aparece.
EXPO_PUBLIC_WHATSAPP=50355555555

# Proyecto de Expo, para que los avisos push lleguen a este teléfono.
# Sale de `npx eas init` (o de expo.dev > el proyecto > Project ID).
# Sin esto la app no pide permiso de avisos y lo dice en la pantalla.
EXPO_PUBLIC_EAS_PROJECT_ID=
