# Variables del frontend. Copiá este archivo como .env y llená los valores.
# Vite solo expone al navegador las que empiezan con VITE_.

# WhatsApp de la tienda para el botón flotante.
# Formato internacional, solo dígitos: 503 (El Salvador) + los 8 del número.
# Si se deja vacío, el botón simplemente no aparece.
VITE_WHATSAPP=50355555555

# Inicio de sesión con Google (botón "Continuar con Google").
# Es el "Client ID" de tipo "Aplicación web" de Google Cloud Console
# (APIs y servicios > Credenciales). Tiene que ser el MISMO valor que el
# GOOGLE_CLIENT_ID del backend. En "Orígenes de JavaScript autorizados"
# agregue http://localhost:5173. Si se deja vacío, el botón no funciona.
VITE_GOOGLE_CLIENT_ID="148683224510-htubuika332kh2ck0f7fkc0fr06gjfjp.apps.googleusercontent.com"
